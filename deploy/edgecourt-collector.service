# EdgeCourt — collector de cuotas de Betfair (SOLO LECTURA)
#
# Recoge observaciones de mercado y las escribe en PostgreSQL. No existe en todo
# el proyecto codigo capaz de enviar, modificar ni cancelar una apuesta.
#
# Instalacion: bash scripts/install_service.sh  (no se instala solo)

[Unit]
Description=EdgeCourt Betfair odds collector (read-only, paper mode)
Documentation=file:///home/willy/Proyectos/Develop/EdgeCourt/README.md

# La red debe estar operativa: el collector habla con la API de Betfair.
After=network-online.target postgresql.service
Wants=network-online.target
# PostgreSQL es la fuente de verdad; sin el, el collector no puede escribir.
Requires=postgresql.service

# Limite de reintentos: si falla 5 veces en 10 minutos, systemd se rinde y deja
# el servicio en estado 'failed'. Sin este tope, un error de configuracion
# generaria reinicios indefinidos que solo llenarian el journal y consumirian
# cuota de la API de Betfair.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple

# Nunca como root.
User=willy
Group=willy
WorkingDirectory=/home/willy/Proyectos/Develop/EdgeCourt

# Se ejecuta el binario del entorno virtual del proyecto, sin pasar por `uv`:
# una capa menos y un PID directo, que es lo que systemd sabe supervisar.
ExecStart=/home/willy/Proyectos/Develop/EdgeCourt/.venv/bin/edgecourt collector start

# NO se define EnvironmentFile: la configuracion la lee la propia aplicacion del
# .env del proyecto (ruta absoluta, permisos 600). Asi ningun secreto aparece en
# este fichero, que es legible por cualquier usuario del sistema.

# Apagado ordenado: el collector convierte SIGTERM en una parada limpia que
# termina el ciclo en curso, cierra la sesion en Betfair y libera el bloqueo.
KillSignal=SIGTERM
TimeoutStopSec=60

# --- Politica de reinicio ---------------------------------------------------
# Se reinicia ante fallos, pero no en bucle: si falla 5 veces en 10 minutos,
# systemd se rinde y deja el servicio en estado 'failed'. Sin ese limite, un
# error de configuracion generaria reintentos indefinidos que solo llenarian el
# journal y consumirian cuota de API.
Restart=on-failure
RestartSec=60
# El limite de intentos (StartLimitIntervalSec / StartLimitBurst) vive en la
# seccion [Unit], no aqui: systemd lo movio hace varias versiones y colocarlo en
# [Service] hace que se ignore en silencio, dejando los reinicios sin tope.

# --- Registro ---------------------------------------------------------------
# La aplicacion detecta systemd y emite JSON por stdout, que el journal indexa.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edgecourt-collector

# --- Endurecimiento ---------------------------------------------------------
# El servicio solo necesita leer su codigo y escribir sus datos y logs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Solo se permite salir a Internet por IP; nada de sockets exoticos.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# ProtectHome=read-only dejaria el .env y los certificados accesibles en lectura,
# pero impediria escribir en data/ y logs/. Se conceden esas dos rutas.
ProtectHome=read-only
ReadWritePaths=/home/willy/Proyectos/Develop/EdgeCourt/data
ReadWritePaths=/home/willy/Proyectos/Develop/EdgeCourt/logs

# Sin esto, los ficheros que crea el servicio quedan legibles por cualquier
# usuario del sistema. Los logs se redactan, pero un log solo lo debe leer quien
# opera el servicio.
UMask=0077

# El collector no deberia acercarse a este limite; si lo hace, es un fallo.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
