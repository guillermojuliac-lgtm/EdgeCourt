# --- Secretos y credenciales (NUNCA versionar) ---
.env
.env.*
!.env.example
*.pem
*.crt
*.key
*.p12
*.pfx
certs/
secrets/

# --- Datos ---
# Se excluye todo el contenido pero se permite a git descender en los
# directorios para poder conservar los .gitkeep que fijan la estructura.
/data/**
!/data/**/
!/data/**/.gitkeep
*.parquet
*.duckdb
*.duckdb.wal
*.db

# --- Modelos entrenados ---
# Los modelos se versionan por manifiesto + hash, nunca por binario en git.
/models/**
!/models/**/
!/models/**/.gitkeep
*.joblib
*.pkl
*.ubj
*.bst

# --- Logs ---
/logs/**
!/logs/.gitkeep
*.log
*.log.*

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Notebooks ---
.ipynb_checkpoints/
notebooks/**/*.ipynb
!notebooks/.gitkeep

# --- Editores / SO ---
.idea/
.vscode/
.DS_Store
