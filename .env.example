# EdgeCourt - plantilla de configuracion.
# Copiar a .env y rellenar. NUNCA versionar el .env real.

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# Modo de apuesta
# ---------------------------------------------------------------------------
# SOLO se acepta el valor "paper". Cualquier otro valor hace que la aplicacion
# falle al arrancar. Esta version NO implementa ejecucion de apuestas reales.
BETTING_MODE=paper

# ---------------------------------------------------------------------------
# Rutas (relativas a la raiz del proyecto salvo que sean absolutas)
# ---------------------------------------------------------------------------
DATA_DIR=data
MODELS_DIR=models
LOGS_DIR=logs

# ---------------------------------------------------------------------------
# Betfair (solo lectura - PHASE 8). Dejar vacio hasta entonces.
# ---------------------------------------------------------------------------
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_APP_KEY=
BETFAIR_CERT_PATH=
BETFAIR_KEY_PATH=

# ---------------------------------------------------------------------------
# Riesgo (paper). Valores usados por el Risk Engine a partir de PHASE 10.
# ---------------------------------------------------------------------------
BANKROLL=1000.0
MAX_STAKE_PERCENTAGE=0.01        # 1% del bankroll por apuesta
MAX_DAILY_EXPOSURE=0.05          # 5% del bankroll al dia
MAX_MARKET_EXPOSURE=0.02         # 2% del bankroll por mercado
MINIMUM_EDGE=0.03                # edge minimo DESPUES de costes
MINIMUM_LIQUIDITY=50.0           # EUR disponibles al precio objetivo
MAXIMUM_DRAWDOWN=0.20            # 20% -> parada de seguridad
KELLY_FRACTION=0.25              # nunca 1.0 (Full Kelly prohibido)
BETFAIR_COMMISSION=0.05          # comision sobre ganancias netas del mercado

# ---------------------------------------------------------------------------
# Telegram (opcional - PHASE 15)
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
