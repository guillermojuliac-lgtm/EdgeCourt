# EdgeCourt - plantilla de configuracion.
# Copiar a .env y rellenar. NUNCA versionar el .env real.

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# Modo de apuesta
# ---------------------------------------------------------------------------
# SOLO se acepta el valor "paper". Cualquier otro valor hace que la aplicacion
# falle al arrancar. Esta version NO implementa ejecucion de apuestas reales.
BETTING_MODE=paper

# ---------------------------------------------------------------------------
# Rutas (relativas a la raiz del proyecto salvo que sean absolutas)
# ---------------------------------------------------------------------------
DATA_DIR=data
MODELS_DIR=models
LOGS_DIR=logs

# ---------------------------------------------------------------------------
# Betfair - SOLO LECTURA
# ---------------------------------------------------------------------------
# EdgeCourt unicamente consulta mercados: no existe codigo capaz de enviar,
# modificar ni cancelar una apuesta. Ver README, seccion "Betfair".
#
# Estos cinco valores son obligatorios para arrancar el collector.
# NUNCA los escribas en el codigo ni los pegues en un chat o un issue.

# Usuario y contrasena de tu cuenta de Betfair.
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# Application key de produccion (la "delayed" NO sirve para precios en vivo).
# Se obtiene con la operacion createDeveloperAppKeys o desde el portal de
# desarrolladores de Betfair.
BETFAIR_APP_KEY=

# Certificado de cliente para el login no interactivo, imprescindible para
# operar 24/7 sin que la sesion caduque a las pocas horas. Rutas absolutas a
# ficheros FUERA del repositorio, con permisos 600.
# El .gitignore ya excluye *.crt, *.key, *.pem y certs/, pero la proteccion real
# es guardarlos fuera del proyecto.
BETFAIR_CERT_PATH=/home/TU_USUARIO/.config/edgecourt/betfair/client.crt
BETFAIR_KEY_PATH=/home/TU_USUARIO/.config/edgecourt/betfair/client.key

# ---------------------------------------------------------------------------
# Collector
# ---------------------------------------------------------------------------
# Segundos entre ciclos. 60 es suficiente: las ventanas de captura mas estrechas
# son de 2 minutos. Bajarlo mucho solo consume peso de API sin ganar precision.
COLLECTOR_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Riesgo (paper). Valores usados por el Risk Engine a partir de PHASE 10.
# ---------------------------------------------------------------------------
BANKROLL=1000.0
MAX_STAKE_PERCENTAGE=0.01        # 1% del bankroll por apuesta
MAX_DAILY_EXPOSURE=0.05          # 5% del bankroll al dia
MAX_MARKET_EXPOSURE=0.02         # 2% del bankroll por mercado
MINIMUM_EDGE=0.03                # edge minimo DESPUES de costes
MINIMUM_LIQUIDITY=50.0           # EUR disponibles al precio objetivo
MAXIMUM_DRAWDOWN=0.20            # 20% -> parada de seguridad
KELLY_FRACTION=0.25              # nunca 1.0 (Full Kelly prohibido)
BETFAIR_COMMISSION=0.05          # comision sobre ganancias netas del mercado

# ---------------------------------------------------------------------------
# Telegram (opcional - PHASE 15)
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
